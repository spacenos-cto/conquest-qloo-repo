# Rehearsal — environment. Copy to .env (never commit .env).

# Qloo mode: "mock" (no key needed, runs today) or "live" (needs the harness + event key)
QLOO_MODE=mock

# ---- LIVE MODE ONLY ----
# Do NOT put the Qloo key in this file. Store it in the harness's private config:
#   npm install --global @qloo/qloo-harness
#   qloo setup --qloo       # paste the event key at the hidden prompt
#   qloo setup --status     # expect: "Qloo data: ready"
# Point the harness at the hackathon API (these two are safe to keep here):
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Local ledger file
REHEARSAL_DB=./rehearsal.sqlite
