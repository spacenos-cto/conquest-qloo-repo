# Conquest — environment. Copy to .env (never commit .env).

# Qloo mode: "mock" (no key needed, runs today) or "live" (needs the harness + event key)
QLOO_MODE=mock

# ---- LIVE MODE ONLY ----
# Do NOT put the Qloo key in this file. Store it in the harness's private config:
#   npm install --global @qloo/qloo-harness
#   qloo setup --qloo       # paste the event key at the hidden prompt
#   qloo setup --status     # expect: "Qloo data: ready"
# Point the harness at the hackathon API (these two are safe to keep here):
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com

# Local ledger file
REHEARSAL_DB=./rehearsal.sqlite

# ---- REAL-WORLD BACKTEST (free) ----
# YouTube Data API v3 key: Google Cloud Console -> enable "YouTube Data API v3" -> Credentials -> API key.
# Set it in your terminal, not in a committed file. A full run uses ~350 of 10,000 free daily units.
# YOUTUBE_API_KEY=

# ---- AI AGENTS (Claude) ----
# Off by default: on localhost the agents use their templates and nothing is spent.
# On the hosted build set CONQUEST_AI=claude and put ANTHROPIC_API_KEY in the host's
# secret settings (never in a committed file).
# CONQUEST_AI=claude
# ANTHROPIC_API_KEY=
# Cheapest model by default; every answer is cached in CONQUEST_AI_DB.
CONQUEST_AI_MODEL=claude-haiku-5-5
# Hard stop: past this many dollars the agents switch back to templates.
AI_BUDGET_USD=15
CONQUEST_AI_DB=./conquest-ai.sqlite
