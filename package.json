{
  "name": "conquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Your fans are out there. Go find them. A strategy game where your real audience (Qloo) is the map and five agents do the legwork.",
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "fingerprint": "tsx src/cli.ts fingerprint",
    "rehearse": "tsx src/cli.ts rehearse",
    "ablation": "tsx src/cli.ts ablation",
    "backtest": "tsx src/cli.ts backtest",
    "serve": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "mcp": "tsx src/mcp.ts",
    "probe": "tsx src/probe.ts",
    "resolve": "tsx src/cli.ts resolve",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "backtest-youtube": "tsx src/cli.ts backtest-youtube",
    "trends-check": "tsx src/cli.ts trends-check",
    "mail:preview": "node --env-file-if-exists=.env --import tsx src/conquest/mail-preview.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.7.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^3.25.76",
    "tsx": "4.19.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spacenos-cto/conquest-qloo-repo.git"
  },
  "keywords": [
    "qloo",
    "taste-graph",
    "agents",
    "strategy-game",
    "creators",
    "comedy",
    "hackathon"
  ]
}
